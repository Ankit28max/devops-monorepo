{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start:api": "cd apps/api && bun run start",
    "start:ws": "cd apps/ws && bun run start",
    "start:web": "cd apps/web && bun run start",
    "db:generate": "bun --filter db generate",
    "db:migrate": "bun --filter db migrate",
    "db:push": "bun --filter db push"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.7.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
