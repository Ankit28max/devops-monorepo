{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "generate:db": "cd packages/db && bunx prisma generate",
    "start:backend": "cd apps/backend && bun run index.ts",
    "start:ws": "cd apps/ws && bun run index.ts",
    "start:frontend": "cd apps/web && bun run start"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.5"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
